{
  "name": "sos",
  "compatibility_date": "2026-01-27",
  // Yalnızca aşağıdaki yollar Worker'dan geçer (eksik JS paketine 404, videolara Range desteği);
  // geri kalan her şey doğrudan statik dosya olarak sunulur.
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/assets/*", "/videos/*"]
  }
}
